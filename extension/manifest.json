{
  "manifest_version": 3,
  "name": "userscripts",
  "version": "1.5.1",
  "description": "Personal local jobs for linux.do, NodeSeek, and ExpiredDomains.",
  "homepage_url": "https://github.com/hareai/userscripts",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "userscripts options",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://linux.do/*",
    "https://www.nodeseek.com/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://127.0.0.1/*",
    "https://[::1]/*",
    "https://api.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://linux.do/*"
      ],
      "js": [
        "lib/beijing-day.js",
        "lib/linuxdo.js",
        "lib/config.js",
        "content/linuxdo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nodeseek.com/*"
      ],
      "js": [
        "lib/beijing-day.js",
        "lib/nodeseek.js",
        "lib/config.js",
        "content/nodeseek.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://member.expireddomains.net/*"
      ],
      "js": [
        "lib/listings.js",
        "lib/config.js",
        "content/expireddomains.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
